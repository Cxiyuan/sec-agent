{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "./frontend",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "frontend/next-env.d.ts"],
  "exclude": ["frontend/node_modules", "frontend/.next"]
}
