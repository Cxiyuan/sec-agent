# ============================================================================
# APT 流量检测规则包 · 分类 02 —— 端口与主机扫描
# ----------------------------------------------------------------------------
# 文件名称    : 02-端口与主机扫描.rules
# 攻击类型    : 端口与主机扫描
# ATT&CK     : TA0043 侦察 / T1046 网络服务发现
# 规则数量    : 7
# SID 段     : 9102001 - 9102007
#
# 检测原理
#   基于 TCP 标志位与连接频次的扫描行为检测,不依赖任何载荷特征,可覆盖未知扫描器。
#
# 误报与适配提示
#   负载均衡、健康检查、CDN 回源会产生大量新建连接,需按网段校准频次阈值。
# ============================================================================

alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[扫描-01] 端口扫描 - 出向高频 SYN(masscan/zmap 特征)"; \
    flags:S; flow:stateless; \
    detection_filter:track by_src, count 100, seconds 60; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence Medium, severity Medium, created_at 2026_10_18; \
    sid:9102001; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[扫描-02] 端口扫描 - 入向高频 SYN"; \
    flags:S; flow:stateless; \
    detection_filter:track by_src, count 100, seconds 60; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence Medium, severity Medium, created_at 2026_10_18; \
    sid:9102002; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[扫描-03] 密集探测 - 单源短时大量新建连接"; \
    flags:S; flow:stateless; \
    detection_filter:track by_src, count 300, seconds 30; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence Medium, severity Medium, created_at 2026_10_18; \
    sid:9102003; rev:1;)

alert tcp any any -> any any ( \
    msg:"[扫描-04] TCP NULL 扫描"; \
    flags:0; flow:stateless; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence High, severity Medium, created_at 2026_10_18; \
    sid:9102004; rev:1;)

alert tcp any any -> any any ( \
    msg:"[扫描-05] TCP FIN 扫描"; \
    flags:F; flow:stateless; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence High, severity Medium, created_at 2026_10_18; \
    sid:9102005; rev:1;)

alert tcp any any -> any any ( \
    msg:"[扫描-06] TCP XMAS 扫描"; \
    flags:FPU; flow:stateless; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence High, severity Medium, created_at 2026_10_18; \
    sid:9102006; rev:1;)

alert udp $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[扫描-07] UDP 端口扫描 - 出向高频"; \
    detection_filter:track by_src, count 80, seconds 60; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence Low, severity Low, created_at 2026_10_18; \
    sid:9102007; rev:1;)
