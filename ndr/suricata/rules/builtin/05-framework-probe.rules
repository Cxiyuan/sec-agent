# ============================================================================
# APT 流量检测规则包 · 分类 05 —— 框架与中间件探测
# ----------------------------------------------------------------------------
# 文件名称    : 05-框架与中间件探测.rules
# 攻击类型    : 框架与中间件探测
# ATT&CK     : TA0043 侦察 / T1190
# 规则数量    : 46
# SID 段     : 9105001 - 9105046
#
# 检测原理
#   识别针对主流框架、中间件、运维平台的未授权端点与敏感文件探测。全部使用字面量匹配,性能开销极低。
#
# 误报与适配提示
#   客户环境自身使用这些组件做运维时必然命中,须按资产清单加入抑制名单。
# ============================================================================

# 提示: 若客户环境本身使用该组件做运维,需加入抑制名单
alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[中间件-01] 中间件探测 - Spring Boot Actuator 敏感端点访问"; \
    flow:to_server,established; \
    http.uri; content:"/actuator"; nocase; \
    pcre:"/\/actuator\/(env|heap|heapdump|beans|mappings|configprops|gateway|threaddump|jolokia|loggers|shutdown|trace|httptrace|scheduledtasks|caches|quartz|sessions|refresh|restart|flyway|liquibase)/i"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-admin; \
    metadata:attack_tactic TA0043, attack_technique T1190, confidence High, severity High, created_at 2026_10_18; \
    sid:9105001; rev:4;)
alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[中间件-02] 中间件探测 - Swagger / OpenAPI 接口文档"; \
    flow:to_server,established; \
    http.uri; content:"swagger"; nocase; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1592, confidence Medium, severity Medium, created_at 2026_10_18; \
    sid:9105002; rev:2;)

# 提示: 若客户环境本身使用该组件做运维,需加入抑制名单
