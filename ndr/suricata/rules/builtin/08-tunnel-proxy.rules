# ============================================================================
# APT 流量检测规则包 · 分类 08 —— 隧道与代理
# ----------------------------------------------------------------------------
# 文件名称    : 08-隧道与代理.rules
# 攻击类型    : 隧道与代理
# ATT&CK     : TA0011 命令与控制 / T1090 代理
# 规则数量    : 5
# SID 段     : 9108001 - 9108005
#
# 检测原理
#   识别 SOCKS4/5 代理、HTTP CONNECT 隧道等流量转发行为(均以应用载荷为判据)。
#
# 误报与适配提示
#   存在合法代理的环境须禁用对应条目。
#   [2026-10-21 精简] 原 "IP 层隧道封装 (GRE)"(9108006) 已删除:
#   其判据是 ip_proto:47 协议号 + 每分钟一次的限流,无任何应用载荷,
#   属"协议号即告警"的频率类规则——GRE VPN 与合法封装必然误报。
#   GRE 流量统计建议由 Zeek 的 conn.log 协议分布分析承担。
# ============================================================================

# 提示: 误报: 部分二进制私有协议可能巧合命中前 3 字节
alert tcp any any -> any any ( \
    msg:"[隧道-01] SOCKS5 代理握手 - 无认证模式"; \
    flow:to_server,established; \
    content:"|05 01 00|"; startswith; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0011, attack_technique T1090, confidence High, severity High, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9108001; rev:2;)

alert tcp any any -> any any ( \
    msg:"[隧道-02] SOCKS5 代理握手 - 用户名口令认证"; \
    flow:to_server,established; \
    content:"|05 01 02|"; startswith; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0011, attack_technique T1090, confidence High, severity High, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9108002; rev:2;)

alert tcp any any -> any any ( \
    msg:"[隧道-03] SOCKS5 请求阶段 - TCP CONNECT"; \
    flow:to_server,established; \
    content:"|05 01 00 01|"; startswith; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0011, attack_technique T1090, confidence Medium, severity Medium, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9108003; rev:2;)

alert tcp any any -> any any ( \
    msg:"[隧道-04] SOCKS4 / SOCKS4a 握手"; \
    flow:to_server,established; \
    content:"|04 01|"; depth:2; \
    byte_test:2,>,1023,2,relative; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0011, attack_technique T1090, confidence Medium, severity Medium, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9108004; rev:2;)

# 提示: 误报: 合法 HTTPS 代理场景必然命中,建议仅在内网横向流量启用
alert http any any -> any any ( \
    msg:"[隧道-05] HTTP CONNECT 隧道建立"; \
    flow:to_server,established; \
    http.method; content:"CONNECT"; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0011, attack_technique T1572, confidence Medium, severity Medium, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9108005; rev:2;)
