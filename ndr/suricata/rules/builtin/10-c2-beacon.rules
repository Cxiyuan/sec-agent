# ============================================================================
# APT 流量检测规则包 · 分类 10 —— 命令与控制信标
# ----------------------------------------------------------------------------
# 文件名称    : 10-命令与控制信标.rules
# 攻击类型    : 命令与控制信标
# ATT&CK     : TA0011 / T1071.001
# 规则数量    : 6
# SID 段     : 9110001 - 9110006
#
# 检测原理
#   基于实证样本逆向还原的信标特征,以及 C2 控制面板 API 访问识别。
#
# 误报与适配提示
#   请求头精简类规则误报偏高,建议仅在高价值网段启用。
# ============================================================================

# 提示: 源自实证样本 ws_windows_amd64.exe 二进制还原,零误报
alert http any any -> any any ( \
    msg:"[C2信标-01] C2 信标 - 极简 HTTP GET 信标 (/?a=&f=&t=&p=) 与固定 UA"; \
    flow:to_server,established; \
    http.method; content:"GET"; \
    http.uri; pcre:"/^\/\?a=[^&]*&f=[^&]*&t=[^&]*&p=[0-9]+/"; \
    http.user_agent; content:"Mozilla/5.0 (Windows NT 6.1|3b| rv:48.0) Gecko/20100101 Firefox/48.0"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence High, severity Critical, created_at 2026_10_18; \
    sid:9110001; rev:1;)

alert http any any -> any any ( \
    msg:"[C2信标-02] C2 信标 - 信标 URI 结构命中(UA 无关,覆盖变种)"; \
    flow:to_server,established; \
    http.uri; pcre:"/^\/\?a=[^&]*&f=[^&]*&t=[^&]*&p=[0-9]+/"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9110002; rev:1;)

alert http any any -> any any ( \
    msg:"[C2信标-03] C2 信标 - 陈旧矛盾浏览器 UA (Win7 + Firefox 48)"; \
    flow:to_server,established; \
    http.user_agent; pcre:"/Windows NT 6\.1.*rv:48\.0/"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence Low, severity Medium, created_at 2026_10_18; \
    sid:9110003; rev:1;)

# 提示: 误报偏高,建议仅在高价值网段启用
alert http any any -> any any ( \
    msg:"[C2信标-04] C2 信标 - HTTP 请求头异常精简(缺失 Accept 头)"; \
    flow:to_server,established; \
    http.method; content:"GET"; \
    http.protocol; content:"HTTP/1.1"; \
    http.user_agent; content:"Mozilla"; \
    http.header_names; content:!"Accept"; nocase; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence Low, severity Low, created_at 2026_10_18; \
    sid:9110004; rev:1;)

# 提示: 误报: 正常业务若存在 /api/client/list 类接口需加入抑制名单
alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[C2信标-05] C2 控制面板 API 访问 (client/tunnel/file/dashboard)"; \
    flow:to_server,established; \
    http.uri; content:"/api/"; nocase; \
    pcre:"/\/api\/(client|tunnel|file|dashboard|task|payload|beacon|session)\/(list|ls|info|add|del|exec|upload|download)/i"; \
    detection_filter:track by_src, count 5, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence Medium, severity Critical, created_at 2026_10_18; \
    sid:9110005; rev:2;)

alert http any any -> any any ( \
    msg:"[C2信标-06] 信标式极简查询串 - 全单字母参数名"; \
    flow:to_server,established; \
    http.uri; pcre:"/^\/\?([a-z]=[^&]*&){3,}[a-z]=/i"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9110006; rev:2;)
