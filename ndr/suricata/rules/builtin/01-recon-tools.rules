# ============================================================================
# APT 流量检测规则包 · 分类 01 —— 侦察与攻击工具指纹
# ----------------------------------------------------------------------------
# 文件名称    : 01-侦察与攻击工具指纹.rules
# 攻击类型    : 侦察与攻击工具指纹
# ATT&CK     : TA0043 侦察
# 规则数量    : 29
# SID 段     : 9101001 - 9101029
#
# 检测原理
#   通过 HTTP User-Agent 指纹识别已知攻击工具。命中即代表存在自动化攻击行为,置信度最高。
#
# 误报与适配提示
#   API 网关、健康检查、爬虫会命中非浏览器 UA 规则,该条默认建议关闭或加入抑制。
# ============================================================================

alert http any any -> any any ( \
    msg:"[侦察-01] 攻击工具指纹 - ffuf 目录与参数爆破工具"; \
    flow:to_server,established; \
    http.user_agent; content:"Fuzz Faster U Fool"; nocase; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity High, created_at 2026_10_18; \
    sid:9101001; rev:1;)

