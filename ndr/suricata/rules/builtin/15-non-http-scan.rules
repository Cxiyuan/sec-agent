# ==============================================================================
# APT 流量检测规则包 · 分类 15 —— 非 HTTP 的 C2 通道与扫描器痕迹
# ------------------------------------------------------------------------------
# 文件名称    : 15-非HTTP通道与扫描器痕迹.rules
# 攻击类型    : WebSocket C2 / 扫描器缓存残留 / Syslog 探测 / MQTT 发布
# ATT&CK     : TA0011 命令与控制 / TA0043 侦察
# 规则数量    : 7 条
# SID 段     : 9115001 - 9115007
#
# 检测原理
#   WebSocket 已成为主流 C2 载体(规避 HTTP 日志审计)。演练实证：
#     某外部攻击源 -> 某内网目标:45979 单连接 46,648 次交互
#   扫描器有时会在目标 Redis / PostgreSQL 中留下自身状态键,成为"指纹残留"：
#     Redis:      dddd:nuclei-inflight:nuclei:inflight:pair:<hash>   (Nuclei)
#     Redis:      xxlpoc_sh                                          (XXL-JOB POC)
#     PostgreSQL: qbscan-w.<hash>.ctl / qbscan-sv.<hash>.ctl         (qbscan)
#   这类残留是高置信度的"已被扫描器打过"证据。
#
# 误报与适配提示
#   WebSocket 规则在存在合法长连接业务(在线客服、推送)的环境会命中,
#   需结合目标地址信誉与流量基线抑制。
#   扫描器残留规则依赖应用层解析,需开启对应协议解析。
# ==============================================================================

alert http any any -> any any ( \
    msg:"[C2通道-01] WebSocket 握手高频出现(疑似 C2 通道建立)"; \
    flow:to_server,established; \
    http.header; content:"Sec-WebSocket-Key"; nocase; \
    detection_filter:track by_src, count 50, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0011, attack_technique T1071.001, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9115001; rev:2;)

alert tcp any any -> any 6379 ( \
    msg:"[C2通道-02] Redis 中发现 Nuclei 扫描器状态残留"; \
    flow:to_server,established; \
    content:"nuclei-inflight"; nocase; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595, confidence High, severity High, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9115002; rev:2;)

alert tcp any any -> any 6379 ( \
    msg:"[C2通道-03] Redis 中发现漏洞验证残留键 (xxlpoc 等)"; \
    flow:to_server,established; \
    content:"poc"; nocase; \
    pcre:"/(xxlpoc|poc_|_poc|testpoc)/i"; \
    classtype:attempted-admin; \
    metadata:attack_tactic TA0001, attack_technique T1190, confidence Medium, severity High, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9115003; rev:2;)

alert tcp any any -> any 5432 ( \
    msg:"[C2通道-04] PostgreSQL 中发现 qbscan 扫描器残留"; \
    flow:to_server,established; \
    content:"qbscan"; nocase; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595, confidence High, severity High, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9115004; rev:2;)

alert udp any any -> any 514 ( \
    msg:"[C2通道-05] Syslog 端口探测"; \
    detection_filter:track by_src, count 10, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence Medium, severity Medium, created_at 2026_10_18; \
    sid:9115005; rev:1;)

alert tcp any any -> any 1883 ( \
    msg:"[C2通道-06] MQTT 通配符订阅全部主题(信息窃听或侦察)"; \
    flow:to_server,established; \
    content:"|00 00|"; depth:8; \
    pcre:"/(\$SYS\/#|\+\/#|^#$)/"; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1046, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9115006; rev:1;)

alert tcp any any -> any [25,587,465] ( \
    msg:"[C2通道-07] SMTP 使用 RFC 保留测试域名(开放中继/欺骗探测)"; \
    flow:to_server,established; \
    content:"example"; nocase; \
    pcre:"/(example\.(com|net|org|invalid|test)|external-test-example|example-invalid)/i"; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1590, confidence Medium, severity Medium, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9115007; rev:2;)
