# ============================================================================
# APT 流量检测规则包 · 分类 06 —— 凭据攻击
# ----------------------------------------------------------------------------
# 文件名称    : 06-凭据攻击.rules
# 攻击类型    : 凭据攻击
# ATT&CK     : TA0006 凭据访问 / T1110 暴力破解
# 规则数量    : 8
# SID 段     : 9106001 - 9106008
#
# 检测原理
#   针对 SSH、RDP、数据库、Redis 等服务的暴力破解与未授权访问探测。
#
# 误报与适配提示
#   [2026-10-19 生产调优] 原规则用 flow:to_server,established + detection_filter 计数,
#   会把"一条正常会话里的每个 to_server 数据包"都计一次,导致单个正常 RDP/SSH 连接即误报。
#   已改为 flow:to_server; flags:S; 只统计客户端 SYN(连接请求次数),正常连接每轮仅 1 个 SYN,
#   暴力破解每个尝试 1 个 SYN,阈值仅对真正爆破成立。SSH 同步去掉 app-layer-protocol:ssh
#   (SYN 阶段尚未解析出应用层,保留会导致规则永不命中)。
#   残余误报来源: 入向(by_dst)规则在繁忙 RDP/SSH 服务器(多用户同时登录)上仍可能触发,
#   建议把已知跳板机/堡垒机/终端服务器的源或目的加入 suppression(见 disable/threshold 配置),
#   或上调对应 by_dst 阈值(如 20 -> 50)。运维跳板机、备份服务器、监控采集器须优先加入抑制名单。
# ============================================================================

alert tcp any any -> any 22 ( \
    msg:"[凭据-01] SSH 暴力破解 - 出向(内网主机对外)"; \
    flow:to_server; flags:S; \
    detection_filter:track by_src, count 30, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence High, severity High, created_at 2026_10_18; \
    sid:9106001; rev:1;)

alert tcp any any -> any 22 ( \
    msg:"[凭据-02] SSH 暴力破解 - 入向(外部对内网)"; \
    flow:to_server; flags:S; \
    detection_filter:track by_dst, count 30, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence High, severity High, created_at 2026_10_18; \
    sid:9106002; rev:1;)

alert tcp any any -> any 3389 ( \
    msg:"[凭据-03] RDP 暴力破解 - 出向"; \
    flow:to_server; flags:S; \
    detection_filter:track by_src, count 20, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9106003; rev:1;)

alert tcp any any -> any 3389 ( \
    msg:"[凭据-04] RDP 暴力破解 - 入向"; \
    flow:to_server; flags:S; \
    detection_filter:track by_dst, count 20, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9106004; rev:1;)

alert tcp any any -> any 6379 ( \
    msg:"[凭据-06] Redis 未授权访问与命令探测"; \
    flow:to_server,established; \
    content:"INFO"; nocase; depth:8; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-admin; \
    metadata:attack_tactic TA0008, attack_technique T1210, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9106006; rev:2;)

# 提示: 工业控制与网络设备仍普遍使用 Telnet,误报高,建议按网段启用
alert tcp any any -> any 23 ( \
    msg:"[凭据-07] Telnet 明文协议使用"; \
    flow:to_server,established; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0008, attack_technique T1021.004, confidence Medium, severity Medium, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9106007; rev:2;)

# 提示: 误报高: 合法 FTP 业务普遍存在
alert tcp any any -> any [21,20] ( \
    msg:"[凭据-08] FTP 明文协议使用"; \
    flow:to_server,established; \
    classtype:policy-violation; \
    metadata:attack_tactic TA0008, attack_technique T1021.002, confidence Low, severity Low, created_at 2026_10_18; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    sid:9106008; rev:2;)
