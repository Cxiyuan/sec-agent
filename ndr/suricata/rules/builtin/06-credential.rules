# ============================================================================
# APT 流量检测规则包 · 分类 06 —— 凭据攻击
# ----------------------------------------------------------------------------
# 文件名称    : 06-凭据攻击.rules
# 攻击类型    : 凭据攻击
# ATT&CK     : TA0006 凭据访问 / T1110 暴力破解
# 规则数量    : 5
# SID 段     : 9106006, 9106011 - 9106014
#
# 检测原理（2026-10-21 二次重构：爆破检测改为载荷锚定）
#   2026-10-19 曾把 SSH/RDP 爆破从 "established 逐包计数" 修为
#   "flags:S 只数 SYN"，解决了正常连接逐包误报，但本质上仍是
#   "纯协议栈频率"——不识别应用、不验证载荷，负载均衡探测、
#   监控拨测、合法批量运维同样会被计成爆破。按"必须有应用载荷
#   精准命中"原则，原 6 条纯频率规则（9106001-04 SSH/RDP 暴破、
#   9106007 Telnet 明文、9106008 FTP 明文）全部删除，改建为
#   载荷锚定版本：
#
#   9106011/12 SSH 爆破（出向/入向）：
#     以服务端 SSH 识别串 "SSH-"（每条真实 SSH 会话必含的应用
#     载荷）为计数对象——只有握手成功、载荷确认是 SSH 的会话才
#     被计数。SYN 半连接扫描、RST 拒绝、端口探测不产生该载荷，
#     天然不计入。按"每客户端 IP 的会话数"聚合（by_dst），
#     阈值 30 次/60 秒。
#
#   9106013/14 RDP 爆破（出向/入向）：
#     以 RDP 协商请求中的 "Cookie: mstshash=" 载荷为计数对象
#     （Windows mstsc / FreeRDP 等客户端每次连接必带）。同样
#     只统计载荷确认的 RDP 会话，按源 IP 聚合，阈值 20 次/60 秒。
#
#   载荷锚定 vs 纯频率的本质区别：
#     纯频率数的是"包"，载荷锚定数的是"经应用确认的会话"——
#     前者把任何高频连接都算成攻击，后者只在协议载荷成立时计数，
#     误报面从"全部高频业务"收缩到"真实 SSH/RDP 会话频率异常"。
#
#   已删除且未重建的能力：
#     - Telnet / FTP 明文协议使用检测（9106007/08）：其本质是
#       "端口上有会话即告警"，无载荷判据，属合规基线范畴，
#       建议由 Zeek 协议日志或合规平台统计，不用签名规则硬做。
# ============================================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[凭据-11] SSH 暴力破解 - 出向(内网主机对外,载荷锚定)"; \
    flow:to_client; \
    content:"SSH-"; offset:0; depth:4; \
    detection_filter:track by_dst, count 30, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence High, severity High, created_at 2026_10_21; \
    sid:9106011; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[凭据-12] SSH 暴力破解 - 入向(外部对内网,载荷锚定)"; \
    flow:to_client; \
    content:"SSH-"; offset:0; depth:4; \
    detection_filter:track by_dst, count 30, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence High, severity High, created_at 2026_10_21; \
    sid:9106012; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[凭据-13] RDP 暴力破解 - 出向(载荷锚定)"; \
    flow:to_server; \
    content:"Cookie: mstshash="; nocase; \
    detection_filter:track by_src, count 20, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence Medium, severity High, created_at 2026_10_21; \
    sid:9106013; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[凭据-14] RDP 暴力破解 - 入向(载荷锚定)"; \
    flow:to_server; \
    content:"Cookie: mstshash="; nocase; \
    detection_filter:track by_src, count 20, seconds 60; \
    classtype:attempted-user; \
    metadata:attack_tactic TA0006, attack_technique T1110.001, confidence Medium, severity High, created_at 2026_10_21; \
    sid:9106014; rev:1;)

alert tcp any any -> any 6379 ( \
    msg:"[凭据-06] Redis 未授权访问与命令探测"; \
    flow:to_server,established; \
    content:"INFO"; nocase; depth:8; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-admin; \
    metadata:attack_tactic TA0008, attack_technique T1210, confidence Medium, severity High, created_at 2026_10_18; \
    sid:9106006; rev:2;)
