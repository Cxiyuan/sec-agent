# 智能体线路环境变量（cp .env.example .env 后按需修改）

# NDR 侧 agent_push.token 必须与此处一致（ndr 的 ST_AGENT_PUSH_TOKEN）。
# 留空时 compose 直接拒绝启动——不收无鉴权的安全事件。
AGENT_PUSH_TOKEN=change-me-and-match-ndr

# 统一 PG 连接串（Node pg 格式，不带 SQLAlchemy 的 +psycopg 后缀）。
# 同机部署：默认走宿主机上 ndr 栈发布的 5432（host.docker.internal）；
# 跨机部署（agent 与 ndr 不在同一台）：NDR 的 5432 只绑回环（见仓库红线
# tests/py/test_deploy_exposure.py），必须在 agent 宿主机上建 SSH 隧道把
# NDR 的 127.0.0.1:5432 映射到宿主 172.17.0.1:5432，再保持这里的
# host.docker.internal 不变。隧道示例（agent 宿主机 root）：
#   ssh-keygen -t ed25519 -N '' -f /root/.ssh/id_ed25519   # 公钥追加到 NDR 的 authorized_keys
#   ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
#       -L 172.17.0.1:5432:127.0.0.1:5432 root@<NDR_HOST>
#   # 用 systemd 常驻，别裸跑
XDR_INGEST_PG_URL=postgresql://shentong:shentong@host.docker.internal:5432/shentong

# NDR 的 MCP（分析工具）：URL 指 NDR 的 8090/mcp，令牌是控制台签发的 stmcp_ 串。
# 令牌留空时门铃照收但不启动分析会话。
XDR_NDR_MCP_URL=http://<NDR_HOST>:8090/mcp
XDR_NDR_MCP_TOKEN=

# dsh web 对外端口
AGENT_PORT=3080

# 信任围栏放行的 authority（逗号或空格分隔）：浏览器经 docker 发布口访问时
# Host 不是容器绑定 IP，必须把访问方用的主机名/IP 声明在这里（不带端口=任意端口）。
# 多台机器经局域网访问时，把宿主机 LAN IP 或域名也加进来，如：
# AGENT_TRUSTED_HOSTS=host.docker.internal,192.168.1.10,shentong.local
AGENT_TRUSTED_HOSTS=host.docker.internal

# 留空 = 自动绑定容器内第一块非内部 IPv4（LAN 默认绑定）；需要指定时填具体 IP
DSH_WEB_HOST=

# web 界面登录（原生界面 /login 与分析工作台 /xdr/ui/login 共用这组缝）：
# 不设 = 默认 admin/admin123（现场部署默认值）。上局域网后建议改掉。
#DSH_WEB_AUTH_USER=admin
#DSH_WEB_AUTH_PASSWORD=

# 控制台左侧菜单的「NDR 控制台」入口（NDR 管理台地址，如 https://172.16.196.77）；
# 留空则不显示该入口。控制台本身是站点默认入口（/ 会 303 到 /xdr/ui/）。
DSH_WEB_NDR_CONSOLE_URL=

# 会话签名密钥（工作台自签 Cookie 用）。不设时回落 DSH_WEB_LAUNCH_TOKEN；
# 两条缝都没有则进程随机——重启后所有登录失效（启动日志会警告）。长度 ≥16。
#DSH_WEB_UI_SECRET=

# 部署时拉取的镜像（开发用 docker compose up --build 走本地构建）
AGENT_IMAGE=ghcr.io/cxiyuan/sec-agent/shentong-agent:latest

# ---------- OpenCode 免费模型桥接（可选 sidecar，见 docker-compose.bridge.yml） ----------
# 本地代理密钥：dsh「模型接入（自定义服务商）」里填同一个值。建议 `openssl rand -hex 32`。
# 留空时 compose 直接拒绝启动（避免无鉴权的模型代理）。
OW_BRIDGE_KEY=
# 每日上游请求硬预算（免费额度有限；0 = 不限，不建议）
OW_BRIDGE_DAILY_BUDGET=200
# 桥接镜像（默认 latest；回滚时可固定到某个 sha）
OW_BRIDGE_IMAGE=ghcr.io/cxiyuan/sec-agent/shentong-ow-bridge:latest
# 宿主机 OpenCode 的服务密码（容器非 root 读不了 600 的 service.json，只能经环境注入）
OW_BRIDGE_OPENCODE_PASSWORD=
